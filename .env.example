PB_SUPERUSER_EMAIL="admin@example.com"
PB_SUPERUSER_PASSWORD="change-me-please-12chars-min"

# The public address people use, e.g. https://app.example.com. Links in
# verification, password-reset and invitation emails point here. Email itself
# is set up in the PocketBase dashboard (Settings > Mail settings).
R2_APP_URL=""

# Optional. The Rentman importer normally uses the token an admin saves in
# Settings > Import; this is only a fallback. Use your own account's token.
RENTMAN_BASE_URL="https://api.rentman.net"
RENTMAN_API_TOKEN=""

# LAN address of the Brother QL label printer. Settings > Printing overrides it.
PRINTER_HOST=""

PORT=3001
